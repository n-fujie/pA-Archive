// P/A Archive — data model
// PostgreSQL-compatible. Works with Neon, Supabase, Vercel Postgres, RDS, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  READER
  SUBMITTER
  REVIEWER
  EDITOR
  ADMIN
}

enum RecordStatus {
  DRAFT
  PUBLISHED
  RETRACTED
  WITHDRAWN
}

enum VersionState {
  DRAFT
  PUBLISHED
}

enum PublicationType {
  JOURNAL_ARTICLE
  PREPRINT
  BOOK
  BOOK_CHAPTER
  WORKING_PAPER
  RESEARCH_NOTE
  DATASET
  SOFTWARE
  PEER_REVIEW
  REPORT
  THESIS
  PRESENTATION
  OTHER
}

enum PeerReviewStatus {
  NOT_REVIEWED
  UNDER_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  PUBLISHED
}

enum IdentifierType {
  PAID // P/A Identifier (local, always minted)
  DOI  // formal DOI (only via Crossref / DataCite adapters)
}

// Lifecycle of an identifier. `local` = P/A Identifier issued & usable now.
// DOI identifiers move reserved -> pending -> registered, or -> failed.
enum IdentifierStatus {
  LOCAL
  RESERVED
  PENDING
  REGISTERED
  FAILED
}

enum ReviewAssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ReviewRecommendation {
  NONE
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum RelationType {
  REVIEWS
  IS_REVIEWED_BY
  IS_NEW_VERSION_OF
  IS_PREVIOUS_VERSION_OF
  CITES
  IS_SUPPLEMENT_TO
  IS_SUPPLEMENTED_BY
  CORRECTS
  IS_CORRECTED_BY
}

enum NoticeType {
  CORRECTION
  RETRACTION
  WITHDRAWAL
}

enum AuditAction {
  USER_REGISTER
  USER_ROLE_CHANGE
  USER_DISABLED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  RECORD_CREATE
  METADATA_UPDATE
  FILE_UPLOAD
  FILE_REPLACE
  FILE_DELETE
  VERSION_CREATE
  PUBLISH
  UNPUBLISH
  REVIEW_ASSIGNMENT
  REVIEW_SUBMISSION
  REVIEW_STATUS_CHANGE
  IDENTIFIER_GENERATION
  DOI_REGISTRATION_ATTEMPT
  DOI_REGISTRATION
  DOI_REGISTRATION_FAILED
  CORRECTION
  RETRACTION
  WITHDRAWAL
  ADMIN_CHANGE
  DOWNLOAD
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           Role     @default(SUBMITTER)
  orcid          String?
  affiliation    String?
  organizationId String?
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization?      @relation(fields: [organizationId], references: [id])
  submittedRecords   Record[]           @relation("RecordSubmitter")
  reviewAssignments  ReviewAssignment[] @relation("ReviewAssignee")
  assignmentsMade    ReviewAssignment[] @relation("ReviewAssigner")
  peerReviews        PeerReview[]       @relation("ReviewAuthor")
  auditLogs          AuditLog[]
  sessions           Session[]
  accounts           Account[]
  auditSessions      AuditSession[]     @relation("AuditUploader")

  @@index([role])
  @@map("users")
}

// NextAuth adapter tables (kept for future OAuth / ORCID login).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  rorId     String?  @unique
  type      String   @default("institution") // institution | publisher | funder | repository
  homepage  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  records Record[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Records — a Record is the *concept* (stable identity); RecordVersion holds
// the metadata + files for one version. The concept keeps its PAID forever.
// ---------------------------------------------------------------------------

model Record {
  id            String       @id @default(cuid())
  paidNumber    Int          @unique // the NNNNNN part; allocated transactionally, never reused
  paidYear      Int // the YYYY part, fixed at first publish (or creation year for drafts)
  status        RecordStatus @default(DRAFT)
  category      String // top-level subject category slug
  publicationType PublicationType @default(OTHER)
  peerReviewStatus PeerReviewStatus @default(NOT_REVIEWED)

  submitterId    String
  organizationId String?

  currentVersionId String? @unique // points at the latest PUBLISHED version (or latest draft pre-publish)

  firstPublishedAt DateTime?
  lastPublishedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submitter      User             @relation("RecordSubmitter", fields: [submitterId], references: [id])
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  currentVersion RecordVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       RecordVersion[]  @relation("RecordVersions")
  identifiers    Identifier[]
  reviewAssignments ReviewAssignment[]
  peerReviews    PeerReview[]
  notices        RecordNotice[]
  downloadEvents DownloadEvent[]
  relationsFrom  Relationship[]   @relation("RelationSource")
  relationsTo    Relationship[]   @relation("RelationTarget")
  auditSessions  AuditSession[]   @relation("AuditRecordLink")

  @@index([status])
  @@index([category])
  @@index([publicationType])
  @@index([paidYear])
  @@map("records")
}

model RecordVersion {
  id           String       @id @default(cuid())
  recordId     String
  versionNumber Int // 1, 2, 3 ...
  versionLabel String // "v1", "v2" ... (or author-supplied semantic version)
  state        VersionState @default(DRAFT)

  // --- descriptive metadata -------------------------------------------
  title           String
  subtitle        String?
  abstract        String       @db.Text
  keywords        String[]     @default([])
  language        String       @default("en") // BCP-47
  publicationType PublicationType @default(OTHER)
  licenseId       String?
  publicationDate DateTime?     // author-declared publication date
  references      String        @db.Text @default("") // free-text or newline-delimited
  relatedIdentifiers Json       @default("[]") // [{ identifier, type, relation }]
  funding         Json          @default("[]") // [{ funder, awardNumber, awardTitle }]
  conflictOfInterest String     @db.Text @default("")
  ethicsStatement String        @db.Text @default("")
  notes           String        @db.Text @default("")

  publishedAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  record       Record          @relation("RecordVersions", fields: [recordId], references: [id], onDelete: Cascade)
  currentOf    Record?         @relation("CurrentVersion")
  license      License?        @relation(fields: [licenseId], references: [id])
  files        FileObject[]
  recordAuthors RecordAuthor[]
  identifiers  Identifier[]

  @@unique([recordId, versionNumber])
  @@index([state])
  @@index([title])
  @@map("record_versions")
}

model Author {
  id          String   @id @default(cuid())
  familyName  String?
  givenName   String?
  fullName    String // canonical display name; always populated
  orcid       String?
  affiliation String?
  createdAt   DateTime @default(now())

  recordAuthors RecordAuthor[]

  @@index([orcid])
  @@index([fullName])
  @@map("authors")
}

model RecordAuthor {
  id              String  @id @default(cuid())
  recordVersionId String
  authorId        String
  position        Int
  isCorresponding Boolean @default(false)
  affiliationOverride String?

  recordVersion RecordVersion @relation(fields: [recordVersionId], references: [id], onDelete: Cascade)
  author        Author        @relation(fields: [authorId], references: [id])

  @@unique([recordVersionId, position])
  @@index([authorId])
  @@map("record_authors")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model FileObject {
  id              String  @id @default(cuid())
  recordVersionId String
  storageProvider String // local | s3 | vercel-blob (provider at time of write)
  storageKey      String // opaque key within the provider
  downloadUrl     String? // absolute URL if provider serves directly (blob / s3+cdn)
  originalName    String
  contentType     String
  byteSize        Int
  checksumSha256  String?
  label           String? // "Manuscript", "Supplementary data", ...
  isPrimary       Boolean @default(false)
  supersededById  String? @unique // set when replaced; old rows are kept, never overwritten
  uploadedById    String?
  createdAt       DateTime @default(now())

  recordVersion RecordVersion   @relation(fields: [recordVersionId], references: [id], onDelete: Cascade)
  supersededBy  FileObject?     @relation("FileSupersede", fields: [supersededById], references: [id])
  supersedes    FileObject?     @relation("FileSupersede")
  downloadEvents DownloadEvent[]

  @@index([recordVersionId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Identifiers — PAID always; DOI only through a configured provider.
// ---------------------------------------------------------------------------

model Identifier {
  id              String           @id @default(cuid())
  type            IdentifierType
  value           String           @unique // "PAID:2026:000001" or "10.12345/pa.2026.000001"
  status          IdentifierStatus
  provider        String           @default("local") // local | crossref | datacite
  recordId        String
  recordVersionId String?
  isPrimary       Boolean          @default(false)
  registeredAt    DateTime?
  lastAttemptAt   DateTime?
  attemptCount    Int              @default(0)
  lastError       String?          @db.Text
  providerResponse Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  record        Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordVersion RecordVersion? @relation(fields: [recordVersionId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([recordId])
  @@map("identifiers")
}

// Monotonic PAID allocation. One row per allocation; the autoincrement PK is
// the PAID number. Rows are never deleted, so numbers are never reused.
model PaidAllocation {
  number     Int      @id @default(autoincrement())
  recordId   String?  @unique
  year       Int
  allocatedAt DateTime @default(now())

  @@map("paid_allocations")
}

// ---------------------------------------------------------------------------
// Relationships between records (and to external identifiers)
// ---------------------------------------------------------------------------

model Relationship {
  id               String       @id @default(cuid())
  sourceRecordId   String
  targetRecordId   String?
  targetIdentifier String? // external identifier when target is not in this archive
  relationType     RelationType
  note             String?
  createdById      String?
  createdAt        DateTime     @default(now())

  sourceRecord Record  @relation("RelationSource", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  targetRecord Record? @relation("RelationTarget", fields: [targetRecordId], references: [id], onDelete: SetNull)

  @@index([sourceRecordId])
  @@index([targetRecordId])
  @@map("relationships")
}

// ---------------------------------------------------------------------------
// Peer review
// ---------------------------------------------------------------------------

model ReviewAssignment {
  id           String                 @id @default(cuid())
  recordId     String
  reviewerId   String
  assignedById String
  status       ReviewAssignmentStatus @default(ASSIGNED)
  dueAt        DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  record     Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reviewer   User   @relation("ReviewAssignee", fields: [reviewerId], references: [id])
  assignedBy User   @relation("ReviewAssigner", fields: [assignedById], references: [id])
  review     PeerReview?

  @@unique([recordId, reviewerId])
  @@index([reviewerId])
  @@map("review_assignments")
}

model PeerReview {
  id             String               @id @default(cuid())
  recordId       String
  assignmentId   String?              @unique
  reviewerId     String
  recommendation ReviewRecommendation @default(NONE)
  body           String               @db.Text
  confidential   String               @db.Text @default("") // notes to editor only
  isPublic       Boolean              @default(false)
  // When an editor promotes a review to a citable record of its own:
  reviewRecordId String?              @unique
  submittedAt    DateTime             @default(now())

  record         Record            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  assignment     ReviewAssignment? @relation(fields: [assignmentId], references: [id])
  reviewer       User              @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@index([recordId])
  @@map("peer_reviews")
}

// ---------------------------------------------------------------------------
// Licenses
// ---------------------------------------------------------------------------

model License {
  id        String  @id @default(cuid())
  code      String  @unique // "CC-BY-4.0", "CC0-1.0", "MIT", "arr" ...
  name      String
  url       String?
  isOpen    Boolean @default(true)
  sortOrder Int     @default(100)

  versions RecordVersion[]

  @@map("licenses")
}

// ---------------------------------------------------------------------------
// Notices — corrections / retractions / withdrawals. Never delete history.
// ---------------------------------------------------------------------------

model RecordNotice {
  id          String     @id @default(cuid())
  recordId    String
  type        NoticeType
  reason      String     @db.Text
  detailsUrl  String?
  createdById String?
  createdAt   DateTime   @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("record_notices")
}

// ---------------------------------------------------------------------------
// Audit + analytics
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  actorId    String?
  targetType String // "record" | "record_version" | "file" | "user" | "identifier" | "review"
  targetId   String?
  summary    String
  metadata   Json?
  ipHash     String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DownloadEvent {
  id        String   @id @default(cuid())
  fileId    String
  recordId  String
  ipHash    String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  record Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([recordId])
  @@index([createdAt])
  @@map("download_events")
}

// Named counters (e.g. reserved for future sequences). PAID uses PaidAllocation.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ===========================================================================
// Research-audit layer (upper-design update — 2026-09)
//
// This layer is additive. It does not modify the repository/record/DOI/review
// tables above, and every model here is namespaced `audit_*`.
//
// Design commitments encoded in the SHAPE of these models (see lib/ziran/):
//  - The Ziran orchestration layer (ZiranRun / ZiranStageActivation) records
//    which audit operations FIRED and why. It is not an always-on system:
//    stages can be SUSPENDED / TERMINATED / NOT_APPLICABLE with a recorded
//    reason, and `customState` allows change forms beyond the named set.
//  - Every AuditFinding carries `source` (DOCUMENT vs AI_INFERENCE vs
//    HEURISTIC) and `groundRefs` (spans back into the document). Findings are
//    never generated from model output with no document anchor.
//  - No model here stores a single "quality"/"scientificness"/"truth" score.
//    EvaluationAxisReading values are text only and are never aggregated.
//  - `kind` / `changeForm` / `axis` fields are String, not enum: the named
//    values in lib are a current, revisable vocabulary, not a fixed set.
// ===========================================================================

enum AuditSessionStatus {
  RECEIVED
  PARSING
  ORCHESTRATING
  ANALYZING
  READY
  FAILED
}

enum AuditFindingSource {
  DOCUMENT      // extracted verbatim / structurally from the uploaded document
  HEURISTIC     // produced by a deterministic rule over the document text
  AI_INFERENCE  // produced by a model; always logged as an AiOperation
  MIXED
}

// The 15 processing stages of the spec. The orchestrator decides per session
// which of these fire; NOT_APPLICABLE is a first-class outcome.
enum AuditStage {
  STRUCTURE            // 1  document structure parsing
  CATEGORIES           // 2  main-category extraction
  CATEGORY_IGNITION    // 3  category-establishment audit
  WEAK_OPERATIONAL     // 4  re-analysis with weaker operational vocabulary
  TRANSITION           // 5  transition audit
  HISTORY_REINJECTION  // 6  history-reinjection audit
  BOUNDARY_SCALE       // 7  boundary & scale audit
  ADDRESS_DOMAIN       // 8  address / domain analysis
  CLAIM_EVIDENCE       // 9  local claim–evidence audit
  DOI_REVIEW           // 10 connect to existing DOI / review
  SIMULATION           // 11 simulation-possibility detection
  COUNTERFACTUAL       // 12 counterexample / counterfactual audit
  THEORY_MINE          // 13 theory-mine audit
  REGRESSION           // 14 regression audit (bidirectional)
  REPORT               // 15 auto-audit report generation
}

enum StageActivationState {
  FIRED
  SUSPENDED
  TERMINATED
  RECLASSIFIED
  NOT_APPLICABLE
}

model AuditSession {
  id           String             @id @default(cuid())
  uploaderId   String
  status       AuditSessionStatus @default(RECEIVED)
  // Optional link to an existing archive record (matched by DOI or PAID).
  recordId     String?
  title        String?
  methodologyVersion String        @default("audit-layer-2026-09-phase1")
  failureReason String?           @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  completedAt  DateTime?

  uploader   User             @relation("AuditUploader", fields: [uploaderId], references: [id])
  record     Record?          @relation("AuditRecordLink", fields: [recordId], references: [id], onDelete: SetNull)
  document   SourceDocument?
  ziranRun   ZiranRun?
  segments   DocumentSegment[]
  categories AuditCategory[]
  findings   AuditFinding[]
  transitions        TransitionClaim[]
  dependencies       DependencyEdge[]
  historyReinjections HistoryReinjection[]
  addressNodes       AddressNode[]
  claimEvidence      ClaimEvidenceLink[]
  simulationCandidates SimulationCandidate[]
  theoryMines        TheoryMineFinding[]
  regressions        RegressionFinding[]
  theoryFeedback     TheoryFeedback[]
  evaluationAxes     EvaluationAxisReading[]
  aiOperations       AiOperation[]
  report             AuditReport?

  @@index([uploaderId])
  @@index([status])
  @@index([recordId])
  @@map("audit_sessions")
}

model SourceDocument {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  originalName   String
  contentType    String
  byteSize       Int
  checksumSha256 String
  storageProvider String
  storageKey     String
  extractedText  String   @db.Text
  pageCount      Int?
  wordCount      Int?
  parserName     String
  parserVersion  String
  createdAt      DateTime @default(now())

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("audit_source_documents")
}

// Parsed structure. Only segments the parser can actually identify are
// created — a document with no "methods" section produces no METHOD segment.
enum DocumentSegmentKind {
  TITLE
  ABSTRACT
  SECTION
  SUBSECTION
  PARAGRAPH
  CITATION
  REFERENCE
  FIGURE
  TABLE
  EQUATION
  DATA_STATEMENT
  METHOD
  RESULT
  CONCLUSION
  OTHER
}

model DocumentSegment {
  id        String             @id @default(cuid())
  sessionId String
  kind      DocumentSegmentKind
  label     String?
  order     Int
  charStart Int
  charEnd   Int
  text      String             @db.Text
  parentId  String?

  session AuditSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent  DocumentSegment? @relation("SegmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children DocumentSegment[] @relation("SegmentTree")

  @@index([sessionId, order])
  @@map("audit_document_segments")
}

// The Ziran orchestration record: which audit operations were composed for
// this document and why. Not an ontology, not always-on.
model ZiranRun {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  methodologyVersion String  @default("ziran-orchestration-2026-09-phase1")
  vocabularyNote    String   @db.Text @default("difference/state/transition/dependency/relation/time/scale/boundary/history/access/configuration are the current revisable analytical vocabulary, adopted only where discriminating — not a final ontology.")
  planNote          String?  @db.Text
  createdAt         DateTime @default(now())

  session     AuditSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activations ZiranStageActivation[]

  @@map("audit_ziran_runs")
}

model ZiranStageActivation {
  id          String               @id @default(cuid())
  runId       String
  stage       AuditStage
  state       StageActivationState
  // A change form outside {FIRED,SUSPENDED,TERMINATED,RECLASSIFIED,NOT_APPLICABLE}
  // is recorded here rather than forcing it into the enum.
  customState String?
  reason      String               @db.Text
  segmentScope Json?               // which segments / char ranges this fired over
  order       Int
  firedAt     DateTime             @default(now())

  run ZiranRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stage])
  @@index([runId, order])
  @@map("audit_ziran_stage_activations")
}

model AuditCategory {
  id                       String   @id @default(cuid())
  sessionId                String
  term                     String
  surfaceForms             String[] @default([])
  firstSegmentId           String?
  // null = the audit could not determine this
  treatedAsGiven           Boolean?
  establishmentConditions  String?  @db.Text
  constrainsSubsequent     String   @default("UNKNOWN") // LOW | MEDIUM | HIGH | UNKNOWN
  createdAt                DateTime @default(now())

  session   AuditSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ignition  CategoryIgnitionRecord[]

  @@index([sessionId])
  @@map("audit_categories")
}

model CategoryIgnitionRecord {
  id                          String   @id @default(cuid())
  categoryId                  String
  // Current vocabulary: IGNITION | SUSPENSION | TERMINATION | RECLASSIFICATION.
  // Other change forms go in `customForm`.
  changeForm                  String
  customForm                  String?
  segmentId                   String?
  impliedConditions           String   @db.Text @default("")
  persistsUnderBoundaryChange String   @default("UNKNOWN") // YES | NO | UNKNOWN
  persistsUnderScaleChange    String   @default("UNKNOWN")
  substitutionChangesInference String  @default("UNKNOWN")
  analysisHoldsIfSuspended    String   @default("UNKNOWN")
  note                        String   @db.Text @default("")

  category AuditCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("audit_category_ignition_records")
}

model AuditFinding {
  id               String             @id @default(cuid())
  sessionId        String
  stage            AuditStage
  // Current vocabulary (revisable): CATEGORY_FIXATION | INSUFFICIENT_GROUNDS |
  // INFERENCE_LEAP | BOUNDARY_DEPENDENCE | SCALE_DEPENDENCE |
  // COUNTEREXAMPLE_CANDIDATE | COUNTERFACTUAL_CANDIDATE | SIMULATABLE |
  // HISTORY_DEPENDENCE | THEORY_MINE | REGRESSION | TRANSITION | DEPENDENCY |
  // ADDRESS_CONFIG | CLAIM_EVIDENCE | EXISTING_THEORY_COUNTEREXAMPLE |
  // UNDECIDED | NEEDS_INVESTIGATION | ...
  kind             String
  summary          String
  detail           String             @db.Text @default("")
  source           AuditFindingSource
  inferencePath    String             @db.Text @default("")
  groundRefs       Json               @default("[]") // [{segmentId,charStart,charEnd,quote}]
  uncertaintyText  String             @db.Text @default("")
  undecidable      Boolean            @default(false)
  needsVerification Boolean           @default(false)
  severity         String?            // INFO | LOW | MEDIUM | HIGH | null
  aiOperationId    String?
  createdAt        DateTime           @default(now())

  session      AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  aiOperation  AiOperation? @relation(fields: [aiOperationId], references: [id], onDelete: SetNull)

  @@index([sessionId, stage])
  @@index([sessionId, kind])
  @@map("audit_findings")
}

model TransitionClaim {
  id                  String   @id @default(cuid())
  sessionId           String
  fromState           String
  toState             String
  enablingConditions  String   @db.Text @default("")
  disablingConditions String   @db.Text @default("")
  dependencyNotes     String   @db.Text @default("")
  conditionSensitivity String  @db.Text @default("")
  boundaryScaleVariance String @db.Text @default("")
  groundRefs          Json     @default("[]")
  source              AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_transition_claims")
}

model DependencyEdge {
  id        String   @id @default(cuid())
  sessionId String
  fromLabel String
  toLabel   String
  kind      String   @default("OTHER") // REQUIRES | CONSTRAINS | ENABLES | DERIVED_FROM | OTHER
  note      String   @db.Text @default("")
  groundRefs Json    @default("[]")
  source    AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_dependency_edges")
}

model HistoryReinjection {
  id                     String   @id @default(cuid())
  sessionId              String
  pastKind               String   // MEASUREMENT | CITATION | CLASSIFICATION | REVIEW | MODEL_SELECTION | FAILURE | SIMULATION | INSTITUTIONAL_JUDGMENT | OTHER
  pastDescription        String   @db.Text
  reinjectedIntoKind     String   // RESEARCH_DESIGN | CLASSIFICATION | INFERENCE | ACCESS | PARAMETER | CONCLUSION | OTHER
  reinjectionDescription String   @db.Text
  groundRefs             Json     @default("[]")
  source                 AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_history_reinjections")
}

model AddressNode {
  id             String   @id @default(cuid())
  sessionId      String
  kind           String   // INSTITUTE | UNIVERSITY | COMPANY | STATE | PUBLISHER | FUNDER | GRANT | COMPUTE | DATA_INFRA | MODEL | INSTRUMENT | NETWORK | REGION | INSTITUTION | REVIEW_STRUCTURE | OTHER
  label          String
  roleInGeneration String @db.Text @default("")
  influencesOn   Json     @default("[]") // subset of [category, access, resource, inference, evaluation, publishability]
  groundRefs     Json     @default("[]")
  source         AuditFindingSource @default(DOCUMENT)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_address_nodes")
}

model ClaimEvidenceLink {
  id                    String   @id @default(cuid())
  sessionId             String
  claimText             String   @db.Text
  claimSegmentId        String?
  directGroundRefs      Json     @default("[]")
  citationGroundRefs    Json     @default("[]")
  dataGroundRefs        Json     @default("[]")
  modelDependencyText   String   @db.Text @default("")
  simulationDependencyText String @db.Text @default("")
  inferenceCompletionText String @db.Text @default("")
  counterexampleText    String   @db.Text @default("")
  alternativeExplanationText String @db.Text @default("")
  unverifiedPartsText   String   @db.Text @default("")
  source                AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_claim_evidence_links")
}

model SimulationCandidate {
  id             String   @id @default(cuid())
  sessionId      String
  description    String   @db.Text
  detected       Json     @default("{}") // {stateVariables:[],parameters:[],initialConditions:[],boundaryConditions:[],transitionRules:[],equations:[],predictions:[]}
  providerHandoff Json    @default("{}") // descriptor for a SimulationProvider — no execution in phase 1
  varyableInputs Json     @default("[]") // subset of [initialCondition, boundary, scale, parameter, dependencyRemoval, categorySubstitution, counterfactual]
  groundRefs     Json     @default("[]")
  source         AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_simulation_candidates")
}

model TheoryMineFinding {
  id             String   @id @default(cuid())
  sessionId      String
  claimText      String   @db.Text
  claimSegmentId String?
  mineKind       String   // OVER_GENERALIZATION | ONTOLOGICAL_REIFICATION | METAPHOR_REALIZATION | UNOBSERVABLE_MECHANISM_ASSERTION | CATEGORY_OVER_FIXATION | FUTURE_OVER_SPECIFICATION | LOCAL_TO_UNIVERSAL_LEAP | INSTITUTIONAL_TO_TRUTH | OTHER
  reason         String   @db.Text
  severity       String   @default("LOW") // LOW | MEDIUM | HIGH
  groundRefs     Json     @default("[]")
  source         AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_theory_mine_findings")
}

model RegressionFinding {
  id              String   @id @default(cuid())
  sessionId       String
  description     String   @db.Text
  regressedToWhat String   @db.Text @default("")
  withinDocument  Boolean  @default(true)
  groundRefs      Json     @default("[]")
  source          AuditFindingSource @default(HEURISTIC)

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_regression_findings")
}

// Stage 14 in reverse: the uploaded document / this implementation may require
// revising the methodological layer or the current ("latest") theory itself.
model TheoryFeedback {
  id             String   @id @default(cuid())
  sessionId      String
  targetLayer    String   // METHODOLOGY_LAYER | LATEST_THEORY | ZS_VOCABULARY | OTHER
  proposedChange String   // MODIFICATION | SUSPENSION | RECLASSIFICATION | OTHER
  rationale      String   @db.Text
  groundRefs     Json     @default("[]")
  source         AuditFindingSource @default(HEURISTIC)
  status         String   @default("OPEN") // OPEN | ACKNOWLEDGED | DISMISSED
  createdAt      DateTime @default(now())

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("audit_theory_feedback")
}

// Evaluation axes fire per object. Never summed into one number.
model EvaluationAxisReading {
  id        String   @id @default(cuid())
  sessionId String
  axis      String   // EVIDENCE_FIDELITY | REPRODUCIBILITY | BOUNDARY_SENSITIVITY | SCALE_SENSITIVITY | DEPENDENCY_TRANSPARENCY | HISTORY_TRACEABILITY | COUNTEREXAMPLE_RESPONSIVENESS | REVISABILITY | OTHER
  fired     Boolean  @default(true)
  reading   String   @db.Text // qualitative only — no score field, by design

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, axis])
  @@map("audit_evaluation_axis_readings")
}

// Every model operation is recorded here, even when phase 1 runs none.
// AI is not a privileged subject: this is an operation log like any other.
model AiOperation {
  id                 String   @id @default(cuid())
  sessionId          String
  kind               String   // CLASSIFICATION | SUMMARY | REVIEW | COUNTEREXAMPLE_GENERATION | SIMULATION_SETUP | SEARCH | INFERENCE | OTHER
  model              String?
  modelVersion       String?
  inputSummary       String   @db.Text
  availableInfo      String   @db.Text @default("")
  settings           Json     @default("{}")
  executedAt         DateTime @default(now())
  outputSummary      String   @db.Text
  downstreamInfluence String  @db.Text @default("")

  session  AuditSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([sessionId])
  @@map("audit_ai_operations")
}

model AuditReport {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  generatedAt DateTime @default(now())
  // Only the sections that actually apply to this document. Each entry:
  // { key, title, applicable: true, body }. Non-applicable stages are omitted,
  // not shown empty.
  sections    Json     @default("[]")

  session AuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("audit_reports")
}
