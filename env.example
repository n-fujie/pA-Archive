# ===========================================================================
# P/A Archive — environment configuration
#
# Named "env.example" (no leading dot) because this repo's tooling blocks
# writing dotfiles. For local dev:   cp env.example .env.local
# On Vercel: set these in Project Settings → Environment Variables.
#
# Legend:  [REQUIRED]  must be set in production
#          [OPTIONAL]  has a safe default
#          [DEV ONLY]  must NOT be set in production
#
# NEVER commit real secrets. .env* is git-ignored.
# ===========================================================================

# --- Core / public identity ----------------------------------------------
# [REQUIRED] Canonical public origin, no trailing slash. Also used for
# canonical URLs, citation metadata, sitemap, and auth callbacks.
# Production: https://archive.platodesignlab.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# [OPTIONAL] Server-only override for the canonical origin. When set it wins
# over NEXT_PUBLIC_SITE_URL for everything server-rendered. Never derived from
# VERCEL_URL, so preview deployments keep the production canonical host.
APP_URL=""

NEXT_PUBLIC_OPERATOR_NAME="P/A Institute"
NEXT_PUBLIC_SERVICE_NAME="P/A Archive"
NEXT_PUBLIC_PARENT_DOMAIN="platodesignlab.com"

# --- Database (PostgreSQL-compatible: Neon, Supabase, Vercel Postgres, RDS) ---
# [REQUIRED] Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pa_archive?sslmode=require"
# [OPTIONAL] Direct (non-pooled) URL used ONLY by `prisma migrate`. Required by
# Neon / Supabase pgbouncer setups. Falls back to DATABASE_URL when empty.
# (Prisma reads this exact name.)
DIRECT_DATABASE_URL=""

# --- Auth (NextAuth v5 / Auth.js) ---------------------------------------
# [REQUIRED] Session signing secret.  openssl rand -base64 32
AUTH_SECRET=""
# [REQUIRED on Vercel] Full canonical URL, e.g. https://archive.platodesignlab.com
AUTH_URL="http://localhost:3000"
# [REQUIRED on Vercel] Trust the platform's forwarded host header.
AUTH_TRUST_HOST="true"

# --- Object storage ----------------------------------------------------
# [REQUIRED in production] one of: local | s3 | vercel-blob
# `local` is refused in production unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
# (Vercel's filesystem is ephemeral — use vercel-blob or s3 there).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage-data"                 # [DEV / self-host only]
ALLOW_LOCAL_STORAGE_IN_PRODUCTION="false"          # [OPTIONAL] self-host escape hatch

# vercel-blob: token is auto-injected on Vercel once a Blob store is linked.
BLOB_READ_WRITE_TOKEN=""

# s3 / S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, …)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                                     # non-AWS providers (enables path-style)
S3_PUBLIC_BASE_URL=""                              # optional CDN / public base URL

# [OPTIONAL] Max upload size in bytes (default 52428800 = 50 MiB).
MAX_UPLOAD_BYTES="52428800"

# --- Persistent identifier / DOI adapter -------------------------------
# [OPTIONAL] one of: local | crossref | datacite
# LEAVE AS "local" until a signed DOI-registrar agreement + credentials exist.
# With "local" (or missing credentials) the system issues P/A Identifiers only
# (PAID:YYYY:NNNNNN) and NEVER displays a value as a registered DOI.
DOI_PROVIDER="local"

# [OPTIONAL] Registrant DOI prefix — assigned by Crossref or DataCite ONLY.
# Do NOT invent one. Leave blank until formally assigned.
DOI_PREFIX=""
DOI_SUFFIX_NAMESPACE="pa"                          # → 10.<prefix>/pa.2026.000001

# Crossref deposit credentials (all three activate the provider)
CROSSREF_USERNAME=""
CROSSREF_PASSWORD=""
CROSSREF_PREFIX=""
CROSSREF_DEPOSIT_URL="https://api.crossref.org/deposits"
CROSSREF_DEPOSITOR_NAME="P/A Institute"
CROSSREF_DEPOSITOR_EMAIL=""

# DataCite REST credentials (all three activate the provider)
DATACITE_USERNAME=""
DATACITE_PASSWORD=""
DATACITE_PREFIX=""
DATACITE_API_URL="https://api.datacite.org"        # test: https://api.test.datacite.org

# --- Registration ----------------------------------------------------
# [OPTIONAL] "true": visitors can self-register as SUBMITTER. Elevated roles
# (reviewer/editor/admin) are ALWAYS assigned by an admin regardless.
ALLOW_OPEN_SIGNUP="true"

# --- Research-audit layer (upper-design update) ---------------------
# [OPTIONAL] Dark by default. "true" enables /audit (document upload + audit
# pipeline). Additive DB tables only; existing features are unaffected either way.
AUDIT_ENABLED="false"
AUDIT_MAX_DOC_BYTES="20971520"        # 20 MiB
AUDIT_LLM_ENABLED="false"             # reserved; phase 1 runs no AI

# --- Operational -----------------------------------------------------
# [OPTIONAL] In-process rate limiting for auth/upload/API. Default on.
RATE_LIMIT_ENABLED="true"
# [OPTIONAL] Trust x-forwarded-for / x-real-ip for the client IP (true on Vercel).
TRUST_PROXY_HEADERS="true"
# [OPTIONAL] Include stack traces in server error logs (never sent to clients).
DEBUG_ERRORS="false"
DEBUG_LOG="false"

# --- Initial admin bootstrap (scripts/create-admin.ts) ----------------
# [PRODUCTION, one-time] Create the first administrator, then UNSET these.
#   INITIAL_ADMIN_EMAIL=you@example.org INITIAL_ADMIN_PASSWORD='<12+ chars>' npm run create-admin
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrator"

# --- Seeding ------------------------------------------------------
# [DEV ONLY] Demo users/sample record. All three are ignored when
# NODE_ENV=production. There is NO built-in default password — demo users are
# skipped unless SEED_DEFAULT_PASSWORD is set.
SEED_DEMO_USERS="false"
SEED_DEFAULT_PASSWORD=""
SEED_SAMPLE_RECORD="false"

# --- Production smoke test (scripts/production-smoke.ts) --------------
# [OPTIONAL] Target + credentials for `npm run smoke:prod`.
SMOKE_BASE_URL=""
SMOKE_EMAIL=""
SMOKE_PASSWORD=""
