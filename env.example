# ---------------------------------------------------------------------------
# P/A Archive - environment configuration
#
# This file is named "env.example" (no leading dot) because tooling in this
# repo blocks writing dotfiles. Copy it to ".env.local" for local development:
#
#     cp env.example .env.local
#
# On Vercel, set these in Project Settings -> Environment Variables instead.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ----------------------------------------------------------------
# Public base URL of the deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production value: https://archive.platodesignlab.com

NEXT_PUBLIC_OPERATOR_NAME="P/A Institute"
NEXT_PUBLIC_SERVICE_NAME="P/A Archive"
NEXT_PUBLIC_PARENT_DOMAIN="platodesignlab.com"

# --- Database (PostgreSQL-compatible) -----------------------------------
# Any Postgres provider works: Neon, Supabase, Vercel Postgres, RDS, self-hosted.
# Use a pooled connection string for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pa_archive?sslmode=require"
# Optional direct (non-pooled) URL for migrations, if your provider needs it
# (e.g. Neon / Supabase pgbouncer). Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=""

# --- Auth (NextAuth v5) ------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Required on Vercel preview/prod; usually auto-detected locally.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Object storage ---------------------------------------------------
# One of: local | s3 | vercel-blob
STORAGE_PROVIDER="local"

# local: files written under this dir. Dev / self-hosted only - NOT usable on
# Vercel serverless (ephemeral filesystem). Use s3 or vercel-blob there.
STORAGE_LOCAL_DIR="./storage-data"

# vercel-blob: token is injected automatically on Vercel once a Blob store is
# linked; paste here for local testing.
BLOB_READ_WRITE_TOKEN=""

# s3 / S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, ...)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com (omit for AWS)
S3_PUBLIC_BASE_URL=""   # optional CDN / public base URL for downloads

# Max upload size in bytes (default 52428800 = 50 MiB).
MAX_UPLOAD_BYTES="52428800"

# --- Persistent identifier / DOI adapter -----------------------------
# One of: local | crossref | datacite
# IMPORTANT: leave as "local" until a real DOI contract + credentials exist.
# With "local", the system issues P/A Identifiers (PAID:YYYY:NNNNNN) ONLY and
# never displays a formal DOI as "registered".
DOI_PROVIDER="local"

# The registrant DOI prefix, assigned by Crossref or DataCite ONLY.
# Do NOT invent one. Leave blank until formally assigned.
DOI_PREFIX=""

# DOI suffix namespace for minted DOIs -> 10.PREFIX/pa.2026.000001
DOI_SUFFIX_NAMESPACE="pa"

# Crossref deposit credentials (https://www.crossref.org/documentation/)
CROSSREF_USERNAME=""
CROSSREF_PASSWORD=""
CROSSREF_PREFIX=""
CROSSREF_DEPOSIT_URL="https://api.crossref.org/deposits"
CROSSREF_DEPOSITOR_NAME="P/A Institute"
CROSSREF_DEPOSITOR_EMAIL=""

# DataCite MDS / REST credentials (https://support.datacite.org/docs/api)
DATACITE_USERNAME=""
DATACITE_PASSWORD=""
DATACITE_PREFIX=""
DATACITE_API_URL="https://api.datacite.org"   # test: https://api.test.datacite.org

# --- Registration / open signup ------------------------------------
# "true": visitors can self-register as SUBMITTER. Elevated roles (reviewer,
# editor, admin) are ALWAYS assigned by an admin regardless of this setting.
ALLOW_OPEN_SIGNUP="true"

# --- Seed (local / demo only; never set in production) ------------
SEED_ADMIN_PASSWORD="password123"
SEED_DEFAULT_PASSWORD="password123"
# "true": `npm run db:seed` also inserts one sample published record.
SEED_SAMPLE_RECORD="true"
